<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 중앙 개입 팝업. 접근성 서비스가 TYPE_ACCESSIBILITY_OVERLAY 창으로 띄운다.
  카드 전체 또는 "앱 열기"를 누르면 앱으로 이동, "닫기"는 팝업만 닫는다.
  서비스 Context 로 inflate 하므로 AppCompat 위젯은 쓰지 않는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_intervention_popup"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/popup_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popupBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/popup_body"
        android:textColor="@color/popup_text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/popupDismiss"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/popup_dismiss"
            android:textColor="@color/popup_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/popupOpen"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_popup_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/popup_open"
            android:textColor="@color/popup_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
