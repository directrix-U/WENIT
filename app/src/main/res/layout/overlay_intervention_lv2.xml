<?xml version="1.0" encoding="utf-8"?>
<!-- Lv.2 성찰 질문. 이유를 고르면 아래 버튼이 켜진다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_intervention_popup"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/popup_padding">

    <ImageView
        android:id="@+id/popupCharacter"
        android:layout_width="@dimen/popup_character_size"
        android:layout_height="@dimen/popup_character_size"
        android:contentDescription="@string/popup_character_description"
        android:src="@drawable/ic_character_placeholder" />

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:gravity="center"
        android:textColor="@color/popup_text"
        android:textSize="@dimen/popup_title_text"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reasonFun"
            style="@style/PopupOption"
            android:text="@string/reason_fun" />

        <TextView
            android:id="@+id/reasonBored"
            style="@style/PopupOption"
            android:layout_marginStart="@dimen/popup_option_gap"
            android:text="@string/reason_bored" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_option_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reasonTired"
            style="@style/PopupOption"
            android:text="@string/reason_tired" />

        <TextView
            android:id="@+id/reasonProcrastinating"
            style="@style/PopupOption"
            android:layout_marginStart="@dimen/popup_option_gap"
            android:text="@string/reason_procrastinating" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/popupContinue"
            style="@style/PopupButton.Secondary"
            android:text="@string/popup_lv2_continue" />

        <TextView
            android:id="@+id/popupStop"
            style="@style/PopupButton.Primary"
            android:layout_marginStart="@dimen/popup_option_gap"
            android:text="@string/popup_lv2_stop" />
    </LinearLayout>
</LinearLayout>
